{
  "_comment": "AGEM MCP configuration template. mcp-logic is the only server required (powers evaluate_logical_consistency / logic-based H1). The rest are optional utilities reachable via the meta-tools. Update the mcp-logic --directory and --prover-path to match your checkout.",
  "mcpServers": {
    "headroom": {
      "command": "/your-path-to/.local/bin/headroom",
      "args": [
        "mcp",
        "serve"
      ]
    },
    "mcp-logic": {
      "command": "uv",
      "args": [
        "--directory",
        "/path/to/mcp-logic/src/mcp_logic",
        "run",
        "mcp_logic",
        "--prover-path",
        "/path/to/mcp-logic/ladr/bin"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<1.2.0",
        "mcp-server-fetch"
      ]
    },
    "sqlite": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<1.2.0",
        "mcp-server-sqlite",
        "--db-path",
        "./knowledge_base/agem.db"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "desktop-commander": {
      "command": "npx",
      "args": [
        "-y",
        "@wonderwhy-er/desktop-commander@latest"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "chrome"
      ]
    },
    "docker-mcp": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<1.2.0",
        "docker-mcp"
      ]
    },
    "eml-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "/path/to/astermind-elm-mcp",
        "run",
        "eml-mcp"
      ]
    },
    "astermind-elm": {
      "command": "node",
      "args": [
        "/path/to/astermind-elm-mcp/build/index.js"
      ],
      "env": {
        "ENABLE_PERSISTENCE": "true",
        "LOG_PREDICTIONS": "true",
        "SURREALDB_URL": "ws://127.0.0.1:8002/rpc",
        "SURREALDB_NAMESPACE": "astermind",
        "SURREALDB_DATABASE": "production",
        "SURREALDB_USERNAME": "root",
        "SURREALDB_PASSWORD": "root"
      }
    }
  }
}
