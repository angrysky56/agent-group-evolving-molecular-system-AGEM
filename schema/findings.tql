# Long-term memory: what a RUN concluded, not what a corpus says.
#
# claims.tql holds assertions extracted FROM a corpus. This holds AGEM's own
# conclusions ABOUT a corpus, so a later run can start where the last stopped
# instead of re-deriving. The TNA concept graph is working memory and resets;
# this persists.
#
# Verbatim by design: verdict, coverage and not-ruled-out are copied, never
# condensed. Only `condensed-narrative` may be BabelTele — a compressed verdict
# cannot be audited, and an unaudited verdict is a rumour.

define

  attribute finding-id, value string;
  attribute verdict, value string;
  attribute coverage, value string;
  attribute not-ruled-out, value string;
  attribute run-log-id, value string;
  attribute produced-by-model, value string;
  # "evidential" records a defeasible claim built by defensible-claim.ts from
  # checkable, provenance-bearing grounds. It carries no logical verdict and is
  # excluded from conflict detection — see conflictEvidence in finding-store.ts.
  # Widening this @values set on a live database requires
  # scripts/widen-finding-method-typedb.ts first; an aborted define takes the
  # whole store offline.
  attribute method, value string @values("derived-from-claims", "hand-authored", "evidential");
  attribute condensed-narrative, value string;
  attribute reason, value string;
  attribute finding-outcome, value string @values("contradiction", "no-contradiction", "inconclusive");
  attribute memory-namespace, value string;
  attribute semantic-verdict-kind, value string @values("position-contradiction", "corpus-contradiction", "no-contradiction", "inconclusive");
  attribute attribution-validated, value boolean;
  attribute semantics-validated, value boolean;
  attribute created-at, value datetime-tz;
  attribute finding-status, value string @values("active", "conflict-held", "revalidation-required", "superseded");
  attribute verification-fingerprint, value string;
  attribute revalidation-required-at, value datetime-tz;
  attribute revalidation-changes, value string;

  entity finding,
    owns finding-id @key,
    owns verdict,
    owns coverage,
    owns not-ruled-out @card(0..1),
    owns run-log-id,
    owns produced-by-model,
    owns method,
    owns finding-outcome,
    owns memory-namespace,
    owns semantic-verdict-kind @card(0..1),
    owns attribution-validated @card(0..1),
    owns semantics-validated @card(0..1),
    owns created-at,
    owns finding-status @card(0..1),
    owns verification-fingerprint @card(0..1),
    owns revalidation-required-at @card(0..1),
    owns revalidation-changes @card(0..1),
    owns condensed-narrative @card(0..1),
    owns corpus-id;

  # One n-ary fact: this conclusion rests on these claims, about this corpus.
  # Not a fan of pairwise edges with the arity discarded.
  relation evidences,
    relates conclusion @card(1),
    relates supporting-claim @card(1..),
    relates about-corpus @card(0..1);

  # Memory corrects itself in the open. Never delete an overturned finding —
  # the correction is usually the most valuable record.
  relation supersedes,
    relates newer @card(1),
    relates older @card(1),
    owns reason;

  entity finding,
    plays evidences:conclusion,
    plays supersedes:newer,
    plays supersedes:older;

  relation claim, plays evidences:supporting-claim;
  entity segment, plays evidences:about-corpus;
