# AGEM Configuration
# Copy to .env and adjust values

# ─── LLM Providers ───
LLM_PROVIDER=openrouter               # "ollama" | "openrouter" | "anthropic" | "minimax"
EMBEDDING_PROVIDER=openrouter         # optional: override embedding provider

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest

# OpenRouter (cloud)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_MAX_TOKENS=32768

# Anthropic (cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=8192

# MiniMax (cloud)
MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=Mini-Max-M3
# MINIMAX_EMBEDDING_MODEL=embo-01

# ─── Server ───
PORT=8000
HOST=0.0.0.0

# ─── Knowledge Base ───
# KNOWLEDGE_BASE_PATH=./knowledge_base   # defaults to project root

# ─── AGEM Engine ───
#
# MAX_AGENT_POOL_SIZE — how many concurrent "agent slots" the orchestrator keeps
#   open for internal sub-processes (e.g. Van der Waals gap-bridging agents).
#   Raise this if you want the system to explore more semantic gaps in parallel.
#   Lower it on memory-constrained machines. Default: 20
# MAX_AGENT_POOL_SIZE=20
#
# MAX_ITERATIONS — the total number of top-level orchestration cycles the engine
#   will run before stopping. Each cycle ingests one user message, runs TNA graph
#   updates, SOC metrics, sheaf cohomology, and regime classification.
#   Default: 50  (Set this to 200 for long-running sessions)
# MAX_ITERATIONS=50
#
# VDW_AGENT_MAX_ITERATIONS — the maximum number of reasoning "turns" each
#   Van der Waals sub-agent is allowed before it self-terminates. VdW agents are
#   lightweight exploratory agents spawned when a sheaf H¹ obstruction (semantic
#   gap) is detected. Hitting the cap triggers the "Hit max turns" log message.
#   Raise this to let agents do more work on hard gaps; lower it to keep costs down.
#   Default: 50
# VDW_AGENT_MAX_ITERATIONS=50
#
# CHAT_MAX_TURNS — the maximum number of tool execution turns that the main
#   conversational assistant in the browser interface can perform in response
#   to a single user query. If the agent calls tools repeatedly, it will be
#   forced to stop and finalize its response when it hits this limit.
#   Default: 30
# CHAT_MAX_TURNS=30
#
# ─── Automatic finding memory ───
#
# Recall embeds verbatim verdicts, applies the raw cosine floor, then top-k.
# Dense narratives are optional payloads and never enter the retrieval vector.
# FINDING_RECALL_SIMILARITY_FLOOR=0.4
# FINDING_RECALL_TOP_K=3
# FINDING_UNUSED_RETENTION_DAYS=180
# FINDING_MAX_ACTIVE=500
#
# Typed findings may run a bounded CoD-style densification pass. Every accepted
# claim's role signature must survive exactly; otherwise no payload is stored.
# FINDING_DENSIFICATION_ENABLED=true
# FINDING_DENSIFICATION_TARGET_RATIO=0.28
# FINDING_DENSIFICATION_MAX_PASSES=3
# FINDING_DENSIFICATION_MAX_SOURCE_TOKENS=8192
# FINDING_DENSIFICATION_MAX_OUTPUT_TOKENS=2048
# FINDING_DENSIFICATION_MIN_NARRATIVE_TOKENS=16
#
# ─── Tool execution: bounded recovery and side-effect-aware dispatch ───
#
# TOOL_RETRY_BUDGET — how many times the engine may silently repeat a failed
#   tool call before handing the failure to the model. Applies ONLY to
#   transient faults (network, timeout, rate limit, 5xx) and ONLY to calls
#   that are safe to repeat. Calls that are not idempotent — run_agem_cycle
#   above all, since repeating it would ingest the same text into the graph
#   twice — are never auto-retried regardless of this value.
#   Set to 0 to disable engine-side retries and escalate every failure.
#   Default: 2
# TOOL_RETRY_BUDGET=2
#
# TOOL_MAX_CONCURRENCY — how many READ-ONLY tools may run at once when the
#   model returns several tool calls in a single turn. Reads of the same
#   post-cycle engine state (get_cohomology, get_soc_metrics, detect_gaps, …)
#   are independent and overlap safely. Tools that mutate the graph always run
#   one at a time, in order, no matter what this is set to.
#   Default: 4
# TOOL_MAX_CONCURRENCY=4
#
# CHAT_ENFORCE_WORKFLOW_CONTRACT — require the analysis workflow to actually
#   have happened before a run may finish: at least one run_agem_cycle, at
#   least one get_graph_topology, and — when the graph resolved into two or
#   more concept communities — at least one logical-consistency check. When a
#   requirement is unmet the model is told which one, at most twice per run,
#   and never twice for the same gap. Set to false to let the model decide
#   when it is done.
#   Default: true
# CHAT_ENFORCE_WORKFLOW_CONTRACT=true
#
# LCM_LEVEL1_TOKEN_LIMIT — accumulated LCM context (in tokens) above which a
#   compaction fires. A compaction is an LLM summarization call and it is the
#   single most expensive thing in a reasoning cycle: measured at 49.2s of a
#   53.1s cycle (93%) when this was hardcoded at 1000, which is smaller than one
#   paragraph of real material — so it fired on EVERY cycle.
#   The default is sized for modern context windows so compaction is an
#   occasional consolidation rather than a per-cycle tax. Lower it for a small
#   local model with a short context window; raise it to keep more raw history
#   at the cost of a larger but much rarer compaction call.
#   Default: 32000
# LCM_LEVEL1_TOKEN_LIMIT=32000
#
# EMBEDDING_PROVIDER — which provider serves embeddings. This is SEPARATE from
#   LLM_PROVIDER, and mismatching them is expensive: pointing this at a provider
#   whose configured model is not an embedding model makes every node embedding
#   crawl to a timeout before the hash fallback engages. Set it to the provider
#   that actually hosts your embedding model (e.g. ollama with
#   nomic-embed-text), not the one serving chat.
# EMBEDDING_PROVIDER=ollama
#
# ─── LCM consolidation (the memory bottleneck mechanism) ───
#
# Consolidation used to fire on `total tokens > LCM_LEVEL1_TOKEN_LIMIT`. That
# trigger had three defects, all now fixed, and all worth understanding before
# retuning these:
#   1. CONTENT-BLIND — a token count is not a memory bottleneck. The theory says
#      pressure forces hierarchy over SETTLED structure; compacting material
#      that is still developing destroys articulation that is still needed,
#      which is exactly what the LumpabilityAuditor calls weak compression.
#   2. MONOTONE — the LCM store is append-only, so total size never falls. Once
#      the threshold was crossed it stayed crossed and fired every cycle for the
#      rest of the session.
#   3. QUADRATIC — each firing re-compacted the ENTIRE history, so cost grew
#      with session length (measured: 49s of a 53s cycle, still climbing).
#
# Consolidation now fires when the previous cycle's regime says the material has
# SETTLED (stable/transitioning), or when the ceiling forces it — and only ever
# over entries not already folded into a summary.
#
# LCM_COMPACTION_CEILING_TOKENS — total accumulated size at which consolidation
#   is forced regardless of regime. The genuine memory limit.
#   Default: 32000
# LCM_COMPACTION_CEILING_TOKENS=32000
#
# LCM_COMPACTION_MIN_NEW_TOKENS — how much NEW material (not yet summarised)
#   must accumulate before consolidating is worth the LLM call. This is what
#   stops the append-only store from re-triggering every cycle.
#   Default: 4000
# LCM_COMPACTION_MIN_NEW_TOKENS=4000
#
# LCM_COMPACTION_TARGET_RATIO — fraction of its own size that settled material
#   is compressed to. Previously LCM_LEVEL1_TOKEN_LIMIT was both the trigger and
#   the target; separating them is what allows "reduce this to 40%" without also
#   meaning "compact anything above 40% forever".
#   Default: 0.4
# LCM_COMPACTION_TARGET_RATIO=0.4
